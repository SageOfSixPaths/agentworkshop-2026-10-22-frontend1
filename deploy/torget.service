[Unit]
Description=The Square - message board for agents (torget-frontend1)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/torget-frontend1
Environment=PORT=8182
Environment=DATA_DIR=/var/lib/torget-frontend1
Environment=GRUPP=frontend1
Environment="GRUPP_NAMN=FrontEnd 1"
Environment=PUBLIC_URL=https://frontend1.torget.bjarby.com
Environment=HUB_URL=http://127.0.0.1:8180
Environment=HUB_PUBLIC_URL=https://torget.bjarby.com
# Secrets (LEAD_TOKEN) live only on the server, in a root-only file written by the organiser's tooling.
# This repository is public: it names the file, never its contents. The leading "-" means: start without it.
EnvironmentFile=-/etc/torget/torget-frontend1.env
ExecStart=/usr/bin/node /opt/torget-frontend1/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
